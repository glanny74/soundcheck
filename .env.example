# =============================================================================
# Variables d'environnement SoundCheck
# =============================================================================
# Copier ce fichier en .env (gitignored) et remplir les valeurs.
#
# Deux catégories :
#  - VITE_FIREBASE_* : exposées au CLIENT (préfixe VITE_ obligatoire pour Vite)
#  - RESEND_* / FIREBASE_* (sans VITE_) : SERVEUR uniquement, lues par les
#    serverless functions Vercel (api/*.js). NE JAMAIS préfixer par VITE_.
# =============================================================================

# --- Firebase côté CLIENT (publiques, exposées au navigateur) ----------------
# Ces clés sont publiques par design (Firebase identifie le projet avec, la
# sécurité passe par les Firestore Security Rules).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Firebase Admin côté SERVEUR (privées, ne JAMAIS exposer) ----------------
# Téléchargées depuis Firebase Console > Project Settings > Service Accounts
# > Generate new private key (fichier JSON). Reporter ici les 3 champs.
# NOTE : la private key contient des \n littéraux quand on la colle dans
# le dashboard Vercel — c'est OK, le code la dé-échappe.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Resend (envoi des mails brandés) ----------------------------------------
# Compte gratuit sur resend.com (3000 mails/mois). Récupérer la clé API
# dans le dashboard Resend > API Keys.
RESEND_API_KEY=

# Adresse FROM utilisée par Resend. Sans domaine vérifié, on est limité à
# `onboarding@resend.dev` (ne peut envoyer qu'à l'email du compte Resend).
# Avec un domaine vérifié : "SoundCheck <noreply@tondomaine.com>".
RESEND_FROM_EMAIL=SoundCheck <onboarding@resend.dev>
